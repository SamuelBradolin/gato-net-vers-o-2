# ====================================================================
# GATO NET — CONFIGURAÇÕES DE AMBIENTE (.env) PARA VPS VIRTARIX
# ====================================================================
# INSTRUÇÕES:
# 1. Copie este arquivo para .env na raiz do projeto na VPS:
#    cp .env.example .env
# 2. Defina senhas fortes e únicas para o PostgreSQL antes de iniciar.
# 3. NUNCA envie o arquivo .env preenchido para o GitHub ou controle de versão!
# ====================================================================

# Porta interna da aplicação Node.js (Padrão: 3000)
PORT=3000
NODE_ENV=production

# --------------------------------------------------------------------
# BANCO DE DADOS POSTGRESQL 16 (DOCKER COMPOSE)
# --------------------------------------------------------------------
# Nome de usuário do PostgreSQL
POSTGRES_USER=gatonet_user

# Senha forte gerada para o PostgreSQL (ex: gere com 'openssl rand -hex 16')
# SUBSTITUA O VALOR ABAIXO POR UMA SENHA SEGURA:
POSTGRES_PASSWORD=SubstituaPorUmaSenhaForteEUnica_123!

# Nome da base de dados principal
POSTGRES_DB=gatonet_db

# String de conexão completa utilizada pelo backend
# (No Docker Compose, o host do banco é 'postgres')
DATABASE_URL=postgres://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB}

# --------------------------------------------------------------------
# DOMÍNIO E URL PÚBLICA DA PLATAFORMA
# --------------------------------------------------------------------
# URL pública sob a qual o Nginx / SSL responderá
# Exemplo: https://gatonet.tv ou https://seu-dominio.com.br
APP_URL=https://seusite.com.br

# --------------------------------------------------------------------
# SEGURANÇA E CHAVES ADICIONAIS
# --------------------------------------------------------------------
# Chave secreta de sessão / cookies (gere com 'openssl rand -hex 32')
SESSION_SECRET=SubstituaPorUmaChaveSecretaAleatoriaDe64Caracteres

# Desativar HMR em produção
DISABLE_HMR=true
