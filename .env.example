# Gato Net Environment Configuration
# Virtarix VPS - Ubuntu 24.04 LTS

# Port for the Node.js server (Default: 3000)
PORT=3000

# PostgreSQL 16 Connection URL (Configured on Virtarix VPS)
# When empty or unavailable, Gato Net automatically uses persistent server-side storage (.data/gatonet_db.json)
DATABASE_URL="postgres://gatonet_user:AltereEssaSenhaForte123!@localhost:5432/gatonet_db"

# PostgreSQL credentials for Docker Compose
POSTGRES_USER="gatonet_user"
POSTGRES_PASSWORD="AltereEssaSenhaForte123!"
POSTGRES_DB="gatonet_db"

# GEMINI_API_KEY: Optional runtime variable for AI features
GEMINI_API_KEY=""

# APP_URL: The public URL of the Gato Net platform
APP_URL="http://localhost:3000"
